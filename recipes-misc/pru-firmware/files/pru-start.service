[Unit]
Description=Load and start the PRU0 stepper firmware (remoteproc)
After=systemd-modules-load.service systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# pru-start waits up to 90 s for the PRU remoteproc driver
TimeoutStartSec=120
ExecStart=/usr/sbin/pru-start start
ExecStop=/usr/sbin/pru-start stop

[Install]
WantedBy=multi-user.target
