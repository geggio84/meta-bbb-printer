From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matteo Geromin <geromin.matteo@gmail.com>
Date: Sat, 7 Nov 2026 20:00:00 +0100
Subject: [PATCH] PRU_stepper: port to the kernel 6.x PRU remoteproc RPMsg

Recent kernels (pru_rproc + virtio_rpmsg + rpmsg_char) no longer
support the mailbox based RPMsg and the TYPE_CUSTOM/TYPE_PRU_INTS
resource of PRU Software Support Package v4/v5:

- kick the PRU through INTC system events 16 (to ARM) and 17 (from
  ARM) with pru_rpmsg_init() from PRU Software Support Package v6
- map system event 17 to host 0 (R31 bit 30) with a .pru_irq_map
  section (intc_map_0.h) instead of the custom resource
- use the v6 linker command file, which places .pru_irq_map
- announce the channel as "rpmsg-raw" so that rpmsg_char creates
  /dev/rpmsgN for it (a udev rule links it to /dev/rpmsg_pru30, so
  Marlin is unchanged)
- pass the radix to ltoa(), the TI PRU C library ltoa() takes 3 arguments

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff -ruN a/PRU_stepper/AM335x_PRU.cmd b/PRU_stepper/AM335x_PRU.cmd
--- a/PRU_stepper/AM335x_PRU.cmd	2026-11-07 21:59:17.140000000 +0100
+++ b/PRU_stepper/AM335x_PRU.cmd	2026-11-07 22:00:14.848000000 +0100
@@ -1,6 +1,6 @@
 /****************************************************************************/
 /*  AM335x_PRU.cmd                                                          */
-/*  Copyright (c) 2015  Texas Instruments Incorporated                      */
+/*  Copyright (c) 2015-2021  Texas Instruments Incorporated                 */
 /*                                                                          */
 /*    Description: This file is a linker command file that can be used for  */
 /*                 linking PRU programs built with the C compiler and       */
@@ -21,9 +21,11 @@
 
 	PRU_DMEM_0_1	: org = 0x00000000 len = 0x00002000 CREGISTER=24 /* 8kB PRU Data RAM 0_1 */
 	PRU_DMEM_1_0	: org = 0x00002000 len = 0x00002000	CREGISTER=25 /* 8kB PRU Data RAM 1_0 */
+
+	  PAGE 2:
 	PRU_SHAREDMEM	: org = 0x00010000 len = 0x00003000 CREGISTER=28 /* 12kB Shared RAM */
 
-	DDR			    : org = 0x80000000 len = 0x00000100	CREGISTER=31
+	DDR			    : org = 0x80000000 len = 0x00010000	CREGISTER=31
 	L3OCMC			: org = 0x40000000 len = 0x00010000	CREGISTER=30
 
 
@@ -81,4 +83,9 @@
 	.fardata	>  PRU_DMEM_0_1, PAGE 1
 
 	.resource_table > PRU_DMEM_0_1, PAGE 1
+
+	.pru_irq_map (COPY) :
+	{
+		*(.pru_irq_map)
+	}
 }
diff -ruN a/PRU_stepper/intc_map_0.h b/PRU_stepper/intc_map_0.h
--- a/PRU_stepper/intc_map_0.h	1970-01-01 01:00:00.000000000 +0100
+++ b/PRU_stepper/intc_map_0.h	2026-11-07 22:00:14.904000000 +0100
@@ -0,0 +1,27 @@
+/*
+ * intc_map_0.h
+ *
+ * PRU-ICSS INTC mapping for PRU0, applied by the kernel pru_rproc driver
+ * from the .pru_irq_map section. It replaces the TYPE_CUSTOM/TYPE_PRU_INTS
+ * resource table entry, which recent kernels do not support anymore.
+ *
+ * Based on PRU Software Support Package v6 PRU_RPMsg_Echo_Interrupt0.
+ */
+
+#ifndef _INTC_MAP_0_H_
+#define _INTC_MAP_0_H_
+
+#include <stddef.h>
+#include <rsc_types.h>
+
+#pragma DATA_SECTION(my_irq_rsc, ".pru_irq_map")
+#pragma RETAIN(my_irq_rsc)
+struct pru_irq_rsc my_irq_rsc  = {
+	0,			/* type = 0 */
+	1,			/* number of system events being mapped */
+	{
+		{17, 0, 0},	/* {sysevt, channel, host interrupt}: ARM -> PRU0 kick */
+	},
+};
+
+#endif /* _INTC_MAP_0_H_ */
diff -ruN a/PRU_stepper/main.c b/PRU_stepper/main.c
--- a/PRU_stepper/main.c	2026-11-07 21:59:17.140000000 +0100
+++ b/PRU_stepper/main.c	2026-11-07 22:00:33.724000000 +0100
@@ -40,8 +40,8 @@
 #include <rsc_types.h>
 #include <pru_virtqueue.h>
 #include <pru_rpmsg.h>
-#include <sys_mailbox.h>
 #include "resource_table.h"
+#include "intc_map_0.h"
 #include "stepper_pru.h"
 #include "../pins.h"
 #include "../common_pru.h"
@@ -85,19 +85,15 @@
 	/* allow OCP master port access by the PRU so the PRU can read external memories */
 	CT_CFG.SYSCFG_bit.STANDBY_INIT = 0;
 
-	/* clear the status of event MB_INT_NUMBER (the mailbox event) and enable the mailbox event */
-	CT_INTC.SICR_bit.STS_CLR_IDX = MB_INT_NUMBER;
-	CT_MBX.IRQ[MB_USER].ENABLE_SET |= 1 << (MB_FROM_ARM_HOST * 2);
+	/* Clear the status of the PRU-ICSS system event that the ARM will use to 'kick' us */
+	CT_INTC.SICR_bit.STS_CLR_IDX = FROM_ARM_HOST;
 
 	/* Make sure the Linux drivers are ready for RPMsg communication */
 	status = &resourceTable.rpmsg_vdev.status;
 	while (!(*status & VIRTIO_CONFIG_S_DRIVER_OK));
 
-	/* Initialize pru_virtqueue corresponding to vring0 (PRU to ARM Host direction) */
-	pru_virtqueue_init(&transport.virtqueue0, &resourceTable.rpmsg_vring0, &CT_MBX.MESSAGE[MB_TO_ARM_HOST], &CT_MBX.MESSAGE[MB_FROM_ARM_HOST]);
-
-	/* Initialize pru_virtqueue corresponding to vring1 (ARM Host to PRU direction) */
-	pru_virtqueue_init(&transport.virtqueue1, &resourceTable.rpmsg_vring1, &CT_MBX.MESSAGE[MB_TO_ARM_HOST], &CT_MBX.MESSAGE[MB_FROM_ARM_HOST]);
+	/* Initialize the RPMsg transport structure */
+	pru_rpmsg_init(&transport, &resourceTable.rpmsg_vring0, &resourceTable.rpmsg_vring1, TO_ARM_HOST, FROM_ARM_HOST);
 
 	counter = 10;
 
@@ -107,42 +103,34 @@
 	PRU0_CTRL.CTPPR0_bit.C28_BLK_POINTER = 0x0100;
 
 	/* Create the RPMsg channel between the PRU and ARM user space using the transport structure. */
-	while(pru_rpmsg_channel(RPMSG_NS_CREATE, &transport, CHAN_NAME, CHAN_DESC, CHAN_PORT) != PRU_RPMSG_SUCCESS);
+	while(pru_rpmsg_channel(RPMSG_NS_CREATE, &transport, CHAN_NAME, CHAN_PORT) != PRU_RPMSG_SUCCESS);
 	while(1){
-		/* Check bit 31 of register R31 to see if the mailbox interrupt has occurred */
+		/* Check bit 30 of register R31 to see if the ARM has kicked us */
 		if(__R31 & HOST_INT){
-			/* Clear the mailbox interrupt */
-			CT_MBX.IRQ[MB_USER].STATUS_CLR |= 1 << (MB_FROM_ARM_HOST * 2);
-			/* Clear the event status, event MB_INT_NUMBER corresponds to the mailbox interrupt */
-			CT_INTC.SICR_bit.STS_CLR_IDX = MB_INT_NUMBER;
-			/* Use a while loop to read all of the current messages in the mailbox */
-			while (CT_MBX.MSGSTATUS_bit[MB_FROM_ARM_HOST].NBOFMSG > 0) {
-				/* Check to see if the message corresponds to a receive event for the PRU */
-				if (CT_MBX.MESSAGE[MB_FROM_ARM_HOST] == 1) {
-					/* Receive the message */
-					if(pru_rpmsg_receive(&transport, &src, &dst, &message, &len) == PRU_RPMSG_SUCCESS){
-						/* Decode message from Marlin Application */
-						if(strcmp(message, START_REQ) == 0) {
-							if (pru_started) {
-								pru_rpmsg_send(&transport, dst, src, START_ALREADY_MSG, sizeof(START_ALREADY_MSG));
-							} else {
-								pru_started = 1;
-								pru_rpmsg_send(&transport, dst, src, START_MSG, sizeof(START_MSG));
-							}
-						} else if (strcmp(message, STOP_REQ) == 0) {
-							if (pru_started) {
-								pru_started = 0;
-								pru_rpmsg_send(&transport, dst, src, STOP_MSG, sizeof(STOP_MSG));
-							} else {
-								pru_rpmsg_send(&transport, dst, src, STOP_ALREADY_MSG, sizeof(STOP_ALREADY_MSG));
-							}
-						} else if (strcmp(message, VER_REQ) == 0) {
-							message[2] = VER_MAJ;
-							message[1] = VER_MIN;
-							message[0] = VER_REL;
-							pru_rpmsg_send(&transport, dst, src, message, 3);
-						}
+			/* Clear the event status */
+			CT_INTC.SICR_bit.STS_CLR_IDX = FROM_ARM_HOST;
+			/* Receive all available messages, multiple messages can be sent per kick */
+			while(pru_rpmsg_receive(&transport, &src, &dst, &message, &len) == PRU_RPMSG_SUCCESS){
+				/* Decode message from Marlin Application */
+				if(strcmp(message, START_REQ) == 0) {
+					if (pru_started) {
+						pru_rpmsg_send(&transport, dst, src, START_ALREADY_MSG, sizeof(START_ALREADY_MSG));
+					} else {
+						pru_started = 1;
+						pru_rpmsg_send(&transport, dst, src, START_MSG, sizeof(START_MSG));
+					}
+				} else if (strcmp(message, STOP_REQ) == 0) {
+					if (pru_started) {
+						pru_started = 0;
+						pru_rpmsg_send(&transport, dst, src, STOP_MSG, sizeof(STOP_MSG));
+					} else {
+						pru_rpmsg_send(&transport, dst, src, STOP_ALREADY_MSG, sizeof(STOP_ALREADY_MSG));
 					}
+				} else if (strcmp(message, VER_REQ) == 0) {
+					message[2] = VER_MAJ;
+					message[1] = VER_MIN;
+					message[0] = VER_REL;
+					pru_rpmsg_send(&transport, dst, src, message, 3);
 				}
 			}
 		}
diff -ruN a/PRU_stepper/resource_table.h b/PRU_stepper/resource_table.h
--- a/PRU_stepper/resource_table.h	2026-11-07 21:59:17.140000000 +0100
+++ b/PRU_stepper/resource_table.h	2026-11-07 22:00:14.904000000 +0100
@@ -66,36 +66,26 @@
 /* Definition for unused interrupts */
 #define HOST_UNUSED		255
 
-/* Mapping sysevts to a channel. Each pair contains a sysevt, channel
- * 		Mapping event 60 (Mbox0 mailbox interrupt for pru0) to channel 0
- * */
-struct ch_map pru_intc_map[] = { {60, 0},
-			       };
-
 struct my_resource_table {
 	struct resource_table base;
 
-	uint32_t offset[2]; /* Should match 'num' in actual definition */
+	uint32_t offset[1]; /* Should match 'num' in actual definition */
 
 	/* rpmsg vdev entry */
 	struct fw_rsc_vdev rpmsg_vdev;
 	struct fw_rsc_vdev_vring rpmsg_vring0;
 	struct fw_rsc_vdev_vring rpmsg_vring1;
-
-	/* intc definition */
-	struct fw_rsc_custom pru_ints;
 };
 
 #pragma DATA_SECTION(resourceTable, ".resource_table")
 #pragma RETAIN(resourceTable)
 struct my_resource_table resourceTable = {
 	1,	/* Resource table version: only version 1 is supported by the current driver */
-	2,	/* number of entries in the table */
+	1,	/* number of entries in the table */
 	0, 0,	/* reserved, must be zero */
 	/* offsets to entries */
 	{
 		offsetof(struct my_resource_table, rpmsg_vdev),
-		offsetof(struct my_resource_table, pru_ints),
 	},
 
 	/* rpmsg vdev entry */
@@ -113,36 +103,19 @@
 	},
 	/* the two vrings */
 	{
-			0,								//da, will be populated by host, can't pass it in
+			FW_RSC_ADDR_ANY,				//da, will be populated by host, can't pass it in
 			16,								//align (bytes),
 			PRU_RPMSG_VQ0_SIZE,				//num of descriptors
 			0,								//notifyid, will be populated, can't pass right now
 			0								//reserved
 	},
 	{
-			0, 								//da, will be populated by host, can't pass it in
+			FW_RSC_ADDR_ANY,				//da, will be populated by host, can't pass it in
 			16, 							//align (bytes),
 			PRU_RPMSG_VQ1_SIZE, 			//num of descriptors
 			0, 								//notifyid, will be populated, can't pass right now
 			0 								//reserved
 	},
-
-	{
-		TYPE_CUSTOM, TYPE_PRU_INTS,
-		sizeof(struct fw_rsc_custom_ints),
-		{ /* PRU_INTS version */
-		  0x0000,
-		  /* Channel-to-host mapping, 255 for unused
-		   * 		Mapping Channel-1 to Host-1 (PRU0/1 R31 bit 31)
-		   * */
-		  0, HOST_UNUSED, HOST_UNUSED, HOST_UNUSED, HOST_UNUSED,
-		  HOST_UNUSED, HOST_UNUSED, HOST_UNUSED, HOST_UNUSED, HOST_UNUSED,
-		  /* Number of evts being mapped to channels */
-		  (sizeof(pru_intc_map) / sizeof(struct ch_map)),
-		  /* Pointer to the structure containing mapped events */
-		  pru_intc_map,
-		},
-	},
 };
 
 #endif /* _RSC_TABLE_PRU_H_ */
diff -ruN a/PRU_stepper/stepper_pru.c b/PRU_stepper/stepper_pru.c
--- a/PRU_stepper/stepper_pru.c	2026-11-07 21:59:17.140000000 +0100
+++ b/PRU_stepper/stepper_pru.c	2026-11-07 22:11:24.336000000 +0100
@@ -6,7 +6,6 @@
 #include <rsc_types.h>
 #include <pru_virtqueue.h>
 #include <pru_rpmsg.h>
-#include <sys_mailbox.h>
 #include "stepper_pru.h"
 #include "../pins.h"
 #include "../speed_lookuptable.h"
@@ -371,30 +370,25 @@
 void debug_step(signed char *steps) {
 
 	/* First send step info */
-	ltoa(OCR1A, message);
+	ltoa(OCR1A, message, 10);
 	pru_rpmsg_send(&transport, dst, src, message, sizeof(message));
-	ltoa(steps[X_AXIS], message);
+	ltoa(steps[X_AXIS], message, 10);
 	pru_rpmsg_send(&transport, dst, src, message, sizeof(message));
-	ltoa(steps[Y_AXIS], message);
+	ltoa(steps[Y_AXIS], message, 10);
 	pru_rpmsg_send(&transport, dst, src, message, sizeof(message));
-	ltoa(steps[Z_AXIS], message);
+	ltoa(steps[Z_AXIS], message, 10);
 	pru_rpmsg_send(&transport, dst, src, message, sizeof(message));
-	ltoa(steps[E_AXIS], message);
+	ltoa(steps[E_AXIS], message, 10);
 	pru_rpmsg_send(&transport, dst, src, message, sizeof(message));
 
 	/* Wait for ACK from Marlin Firmware */
 	while(1){
 		if(__R31 & HOST_INT){
-				/* Clear the mailbox interrupt */
-				CT_MBX.IRQ[MB_USER].STATUS_CLR |= 1 << (MB_FROM_ARM_HOST * 2);
-				/* Clear the event status, event MB_INT_NUMBER corresponds to the mailbox interrupt */
-				CT_INTC.SICR_bit.STS_CLR_IDX = MB_INT_NUMBER;
-				/* Use a while loop to read all of the current messages in the mailbox */
-				/* Check to see if the message corresponds to a receive event for the PRU */
-				if ((CT_MBX.MSGSTATUS_bit[MB_FROM_ARM_HOST].NBOFMSG > 0) && (CT_MBX.MESSAGE[MB_FROM_ARM_HOST] == 1))
-						/* Receive the message */
-						if(pru_rpmsg_receive(&transport, &src, &dst, &message, &len) == PRU_RPMSG_SUCCESS)
-							break;
+				/* Clear the event status */
+				CT_INTC.SICR_bit.STS_CLR_IDX = FROM_ARM_HOST;
+				/* Receive the message */
+				if(pru_rpmsg_receive(&transport, &src, &dst, &message, &len) == PRU_RPMSG_SUCCESS)
+					break;
 		}
 	}
 }
diff -ruN a/PRU_stepper/stepper_pru.h b/PRU_stepper/stepper_pru.h
--- a/PRU_stepper/stepper_pru.h	2026-11-07 21:59:17.140000000 +0100
+++ b/PRU_stepper/stepper_pru.h	2026-11-07 22:00:14.896000000 +0100
@@ -13,31 +13,25 @@
 #include "../pins.h"
 #include "../common_pru.h"
 
-/* PRU0 is mailbox module user 1 */
-#define MB_USER						1
-/* Mbox0 - mail_u1_irq (mailbox interrupt for PRU0) is Int Number 60 */
-#define MB_INT_NUMBER				60
-
 /* Host-0 Interrupt sets bit 30 in register R31 */
 #define HOST_INT					0x40000000
 
-/* The mailboxes used for RPMsg are defined in the Linux device tree
- * PRU0 uses mailboxes 2 (From ARM) and 3 (To ARM)
- * PRU1 uses mailboxes 4 (From ARM) and 5 (To ARM)
+/*
+ * RPMsg uses PRU-ICSS INTC system events (kernel pru_rproc driver, PRU
+ * Software Support Package v6):
+ *  - ARM -> PRU0 kick: system event 17, mapped to channel 0 / host 0
+ *    (R31 bit 30) by the .pru_irq_map section (intc_map_0.h)
+ *  - PRU0 -> ARM: system event 16, the PRU0 "vring" interrupt in the DT
  */
-#define MB_TO_ARM_HOST				3
-#define MB_FROM_ARM_HOST			2
+#define TO_ARM_HOST					16
+#define FROM_ARM_HOST				17
 
 /*
- * Using the name 'rpmsg-client-sample' will probe the RPMsg sample driver
- * found at linux-x.y.z/samples/rpmsg/rpmsg_client_sample.c
- *
- * Using the name 'rpmsg-pru' will probe the rpmsg_pru driver found
- * at linux-x.y.z/drivers/rpmsg/rpmsg_pru.c
+ * The name 'rpmsg-raw' is bound by the kernel rpmsg_char driver, which
+ * creates /dev/rpmsgN (linked to /dev/rpmsg_pru30 by a udev rule).
  */
-#define CHAN_NAME					"rpmsg-pru"
+#define CHAN_NAME					"rpmsg-raw"
 
-#define CHAN_DESC					"Channel 30"
 #define CHAN_PORT					30
 
 volatile register uint32_t __R30;
