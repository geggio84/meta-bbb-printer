From b9355388c4606a1a20e0608d4e1b551786820a64 Mon Sep 17 00:00:00 2001
From: Matteo Geromin <geromin.matteo@gmail.com>
Date: Wed, 4 Nov 2026 03:31:04 +0100
Subject: [PATCH 4/5] ARM: dts: am335x: add BeagleBone Black 3D printer board

Add the device tree for the BeagleBone Black based 3D printer
controller:
 - PRU driven step/dir outputs, endstop inputs
 - bit-banged SPI bus with XPT2046 touchscreen and 4 stepper drivers
 - PCA9685 PWM on i2c1 for heaters, fans and RGB LEDs, DS1340 RTC
 - 2x 1-wire buses for DS18B20 temperature sensors
 - 480x272 LCD on tilcdc with ehrpwm1 backlight
 - front panel rotary encoder and push switch
 - AC power loss reported as KEY_POWER by the tps65217

Ported from the 4.x board file: pinmux converted to AM33XX_PADCONF,
SPI/GPIO properties updated to current bindings, ads7846 u16 properties
now use /bits/ 16, and the da8xx-fb U-Boot framebuffer handoff
properties are dropped (driver removed; tilcdc is used instead).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/ti/omap/Makefile            |   1 +
 .../boot/dts/ti/omap/am335x-bbb-printer.dts   | 460 ++++++++++++++++++
 2 files changed, 461 insertions(+)
 create mode 100644 arch/arm/boot/dts/ti/omap/am335x-bbb-printer.dts

diff --git a/arch/arm/boot/dts/ti/omap/Makefile b/arch/arm/boot/dts/ti/omap/Makefile
index e6f16a963956..d5360dc2cf9e 100644
--- a/arch/arm/boot/dts/ti/omap/Makefile
+++ b/arch/arm/boot/dts/ti/omap/Makefile
@@ -92,6 +92,7 @@ dtb-$(CONFIG_SOC_AM33XX) += \
 	am335x-baltos-ir3220.dtb \
 	am335x-baltos-ir5221.dtb \
 	am335x-base0033.dtb \
+	am335x-bbb-printer.dtb \
 	am335x-bone.dtb \
 	am335x-boneblack.dtb \
 	am335x-boneblack-revd.dtb \
diff --git a/arch/arm/boot/dts/ti/omap/am335x-bbb-printer.dts b/arch/arm/boot/dts/ti/omap/am335x-bbb-printer.dts
new file mode 100644
index 000000000000..4998549c5ac0
--- /dev/null
+++ b/arch/arm/boot/dts/ti/omap/am335x-bbb-printer.dts
@@ -0,0 +1,460 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BeagleBone Black based 3D printer controller board
+ *
+ * Copyright (C) 2012 Texas Instruments Incorporated - https://www.ti.com/
+ * Copyright (C) 2016 Matteo Geromin <geromin.matteo@gmail.com>
+ */
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+#include "am33xx.dtsi"
+#include "am335x-bone-common.dtsi"
+#include "am335x-boneblack-common.dtsi"
+
+/ {
+	model = "TI AM335x BeagleBone Black 3d Printer";
+	compatible = "ti,am335x-bone-black", "ti,am335x-bone", "ti,am33xx";
+
+	chosen {
+		base_dtb = "am335x-bbb-printer.dts";
+		base_dtb_timestamp = __TIMESTAMP__;
+	};
+
+	vin: fixedregulator-vin {
+		compatible = "regulator-fixed";
+		regulator-name = "vin";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-boot-on;
+	};
+
+	power_led {
+		pinctrl-names = "default";
+		pinctrl-0 = <&ext_gpio_pin>;
+
+		compatible = "gpio-leds";
+
+		led-pwr {
+			label = "beaglebone:blue:ledPWR";
+			gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+	};
+
+	/* Front panel rotary encoder (ENC_A, ENC_B) */
+	rotary {
+		compatible = "rotary-encoder";
+		gpios = <&gpio1 28 GPIO_ACTIVE_HIGH>, <&gpio0 31 GPIO_ACTIVE_HIGH>;
+		linux,axis = <REL_X>;
+		rotary-encoder,relative-axis;
+	};
+
+	/* Front panel rotary encoder push switch (ENC_SW) */
+	gpio_keys {
+		compatible = "gpio-keys";
+
+		button-enc-sw {
+			label = "Key SPACE";
+			linux,code = <KEY_SPACE>;
+			gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	pwmleds {
+		compatible = "pwm-leds";
+
+		/* Heaters */
+		extruder {
+			pwms = <&pca9685 7 5000000>;
+			pwm-names = "extruder";
+		};
+		hotbed {
+			pwms = <&pca9685 6 5000000>;
+			pwm-names = "hotbed";
+		};
+
+		/* Fans */
+		fan_1 {
+			pwms = <&pca9685 1 5000000>;
+			pwm-names = "fan_1";
+		};
+		fan_2 {
+			pwms = <&pca9685 4 5000000>;
+			pwm-names = "fan_2";
+		};
+		fan_3 {
+			pwms = <&pca9685 3 5000000>;
+			pwm-names = "fan_3";
+		};
+		fan_4 {
+			pwms = <&pca9685 2 5000000>;
+			pwm-names = "fan_4";
+		};
+
+		/* RGB LED strips */
+		blue_0 {
+			pwms = <&pca9685 10 5000000>;
+			pwm-names = "blue_0";
+		};
+		red_0 {
+			pwms = <&pca9685 11 5000000>;
+			pwm-names = "red_0";
+		};
+		green_0 {
+			pwms = <&pca9685 12 5000000>;
+			pwm-names = "green_0";
+		};
+		blue_1 {
+			pwms = <&pca9685 0 5000000>;
+			pwm-names = "blue_1";
+		};
+		red_1 {
+			pwms = <&pca9685 8 5000000>;
+			pwm-names = "red_1";
+		};
+		green_1 {
+			pwms = <&pca9685 9 5000000>;
+			pwm-names = "green_1";
+		};
+		blue_2 {
+			pwms = <&pca9685 13 5000000>;
+			pwm-names = "blue_2";
+		};
+		red_2 {
+			pwms = <&pca9685 14 5000000>;
+			pwm-names = "red_2";
+		};
+		green_2 {
+			pwms = <&pca9685 15 5000000>;
+			pwm-names = "green_2";
+		};
+	};
+
+	/* 4.3" 480x272 TFT on the LCD controller (tilcdc DRM driver) */
+	panel {
+		compatible = "ti,tilcdc,panel";
+		status = "okay";
+
+		panel-info {
+			ac-bias           = <255>;
+			ac-bias-intrpt    = <0>;
+			dma-burst-sz      = <16>;
+			bpp               = <16>;
+			fdd               = <0x80>;
+			sync-edge         = <0>;
+			sync-ctrl         = <1>;
+			raster-order      = <0>;
+			fifo-th           = <0>;
+		};
+
+		display-timings {
+			timing-480x272p57 {
+				clock-frequency = <9000000>;
+				hactive = <480>;
+				vactive = <272>;
+				hfront-porch = <9>;
+				hback-porch = <44>;
+				hsync-len = <5>;
+				vback-porch = <13>;
+				vfront-porch = <4>;
+				vsync-len = <10>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+			};
+		};
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pwm_bl_pins>;
+
+		pwms = <&ehrpwm1 0 500000 0>;
+		brightness-levels = <0 58 61 66 75 90 125 170 255>;
+		default-brightness-level = <4>;
+		status = "okay";
+	};
+
+	/* Temperature sensors (DS18B20) */
+	onewire_0 {
+		compatible = "w1-gpio";
+		pinctrl-names = "default";
+		pinctrl-0 = <&onewire_0_pins>;
+		gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
+	};
+
+	onewire_1 {
+		compatible = "w1-gpio";
+		pinctrl-names = "default";
+		pinctrl-0 = <&onewire_1_pins>;
+		gpios = <&gpio3 19 GPIO_ACTIVE_HIGH>;
+	};
+
+	spi_gpio {
+		compatible = "spi-gpio";
+		pinctrl-names = "default";
+		pinctrl-0 = <&spi0_pins>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		sck-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
+		miso-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>,
+			   <&gpio0 13 GPIO_ACTIVE_LOW>,
+			   <&gpio0 12 GPIO_ACTIVE_LOW>,
+			   <&gpio1 17 GPIO_ACTIVE_LOW>,
+			   <&gpio0 7 GPIO_ACTIVE_LOW>;
+		num-chipselects = <5>;
+		status = "okay";
+
+		/* XPT2046 resistive touchscreen controller */
+		touchscreen@0 {
+			compatible = "ti,ads7846";
+			reg = <0>;
+			spi-max-frequency = <100000>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&xpt2046_pins>;
+
+			interrupt-parent = <&gpio1>;
+			interrupts = <29 IRQ_TYPE_EDGE_FALLING>;
+			pendown-gpio = <&gpio1 29 GPIO_ACTIVE_HIGH>;
+			ti,pendown-gpio-debounce = <50>;
+
+			vcc-supply = <&vin>;
+			ti,x-min = /bits/ 16 <0>;
+			ti,x-max = /bits/ 16 <4000>;
+			ti,y-min = /bits/ 16 <0>;
+			ti,y-max = /bits/ 16 <4000>;
+			ti,x-plate-ohms = /bits/ 16 <750>;
+			ti,y-plate-ohms = /bits/ 16 <230>;
+			ti,pressure-min = /bits/ 16 <1000>;
+			ti,pressure-max = /bits/ 16 <15000>;
+			ti,settle-delay-usec = /bits/ 16 <150>;
+			ti,debounce-max = /bits/ 16 <5>;
+			ti,debounce-tol = /bits/ 16 <65535>;
+			ti,vref-delay-usecs = /bits/ 16 <450>;
+
+			wakeup-source;
+		};
+
+		/* Stepper motor drivers, driven from userspace via spidev */
+		stepper_x@1 {
+			compatible = "bbb-printer,stepper";
+			spi-max-frequency = <100000>;
+			reg = <1>;
+		};
+
+		stepper_y@2 {
+			compatible = "bbb-printer,stepper";
+			spi-max-frequency = <100000>;
+			reg = <2>;
+		};
+
+		stepper_z@3 {
+			compatible = "bbb-printer,stepper";
+			spi-max-frequency = <100000>;
+			reg = <3>;
+		};
+
+		stepper_e@4 {
+			compatible = "bbb-printer,stepper";
+			spi-max-frequency = <100000>;
+			reg = <4>;
+		};
+	};
+};
+
+&tps {
+	pwrbutton {
+		/* Request a clean shutdown when the mains supply is lost */
+		ti,ac-loss-power-key;
+	};
+};
+
+&i2c1 {
+	status = "okay";
+	clock-frequency = <200000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pins>;
+
+	pca9685: pwm@40 {
+		compatible = "nxp,pca9685-pwm";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pca9685_pins>;
+		#pwm-cells = <2>;
+		reg = <0x40>;
+		status = "okay";
+	};
+
+	ds1340: rtc@68 {
+		compatible = "maxim,ds1340";
+		trickle-resistor-ohms = <250>;
+		reg = <0x68>;
+	};
+};
+
+&tscadc {
+	status = "okay";
+};
+
+&am335x_adc {
+	ti,adc-channels = <0 1 2 3 4 5 6 7>;
+};
+
+&epwmss1 {
+	status = "okay";
+};
+
+&ehrpwm1 {
+	status = "okay";
+};
+
+&lcdc {
+	pinctrl-names = "default";
+	pinctrl-0 = <&lcd_pins>;
+	status = "okay";
+};
+
+&am33xx_pinmux {
+	pinctrl-names = "default";
+	pinctrl-0 = <&hdmiclk_pin_dis &clkout2_pin_dis &stepper_pins &endstop_pins
+		     &frontpanel_button_pin &frontpanel_encoder_pins>;
+
+	stepper_pins: stepper-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_AHCLKX, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[7], DIR X */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD12, PIN_OUTPUT_PULLDOWN, MUX_MODE6)	/* pr1_pru0_pru_r30[14], STEP X */
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_ACLKX, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[0], DIR Y */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD13, PIN_OUTPUT_PULLDOWN, MUX_MODE6)	/* pr1_pru0_pru_r30[15], STEP Y */
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_AXR1, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[6], DIR Z */
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_AHCLKR, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[3], STEP Z */
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_FSX, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[1], DIR E */
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_AXR0, PIN_OUTPUT_PULLDOWN, MUX_MODE5)	/* pr1_pru0_pru_r30[2], STEP E */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD14, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio1_14, FLAG */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD15, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* gpio1_15, Reset_n */
+		>;
+	};
+
+	endstop_pins: endstop-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_ADVN_ALE, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio2_2, END X1 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_OEN_REN, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio2_3, END X2 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_BEN0_CLE, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio2_5, END Y1 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_WEN, PIN_INPUT_PULLUP, MUX_MODE7)		/* gpio2_4, END Y2 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD9, PIN_INPUT_PULLUP, MUX_MODE7)		/* gpio0_23, END Z1 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD10, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio0_26, END Z2 */
+		>;
+	};
+
+	frontpanel_button_pin: frontpanel-button-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_WAIT0, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio0_30, ENC_SW */
+		>;
+	};
+
+	frontpanel_encoder_pins: frontpanel-encoder-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_BEN1, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio1_28, ENC_A */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_WPN, PIN_INPUT_PULLUP, MUX_MODE7)		/* gpio0_31, ENC_B */
+		>;
+	};
+
+	i2c1_pins: i2c1-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_INPUT_PULLUP, MUX_MODE3)	/* i2c1_scl */
+			AM33XX_PADCONF(AM335X_PIN_UART1_RXD, PIN_INPUT_PULLUP, MUX_MODE3)	/* i2c1_sda */
+		>;
+	};
+
+	pwm_bl_pins: pwm-bl-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_A2, PIN_OUTPUT_PULLDOWN, MUX_MODE6)	/* ehrpwm1a, LCD_PWM_BL */
+		>;
+	};
+
+	spi0_pins: spi0-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_4, SPI0_D1 */
+			AM33XX_PADCONF(AM335X_PIN_SPI0_D0, PIN_INPUT_PULLUP, MUX_MODE7)		/* gpio0_3, SPI0_D0 */
+			AM33XX_PADCONF(AM335X_PIN_SPI0_SCLK, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio0_2, SPI0_CLK */
+			AM33XX_PADCONF(AM335X_PIN_SPI0_CS0, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_5, SPI0_CS0 */
+			AM33XX_PADCONF(AM335X_PIN_UART1_RTSN, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_13, SPI0_CS1 */
+			AM33XX_PADCONF(AM335X_PIN_UART1_CTSN, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_12, SPI0_CS2 */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_A1, PIN_OUTPUT_PULLUP, MUX_MODE7)		/* gpio1_17, SPI0_CS3 */
+			AM33XX_PADCONF(AM335X_PIN_ECAP0_IN_PWM0_OUT, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_7, SPI0_CS4 */
+		>;
+	};
+
+	onewire_0_pins: onewire-0-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_A3, PIN_INPUT_PULLUP, MUX_MODE7)		/* gpio1_19, 1wire_0 */
+		>;
+	};
+
+	onewire_1_pins: onewire-1-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_MCASP0_FSR, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio3_19, 1wire_1 */
+		>;
+	};
+
+	xpt2046_pins: xpt2046-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_CSN0, PIN_INPUT_PULLUP, MUX_MODE7)	/* gpio1_29, SPI0_TS_IRQ */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD8, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_22, LCD_TS_BUSY */
+		>;
+	};
+
+	ext_gpio_pin: ext-gpio-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_A0, PIN_OUTPUT_PULLUP, MUX_MODE7)		/* gpio1_16, EXT_GPIO */
+		>;
+	};
+
+	clkout2_pin_dis: clkout2-dis-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_XDMA_EVENT_INTR1, PIN_INPUT, MUX_MODE7)	/* gpio0_20 */
+		>;
+	};
+
+	hdmiclk_pin_dis: hdmiclk-dis-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_A11, PIN_INPUT_PULLDOWN, MUX_MODE7)	/* gpio1_27 */
+		>;
+	};
+
+	pca9685_pins: pca9685-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_GPMC_AD11, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio0_27, PWM_OEn */
+		>;
+	};
+
+	lcd_pins: lcd-pins {
+		pinctrl-single,pins = <
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA0, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA1, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA2, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA3, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA4, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA5, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA6, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA7, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA8, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA9, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA10, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA11, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA12, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA13, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA14, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_DATA15, PIN_OUTPUT, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_VSYNC, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_HSYNC, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_PCLK, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_LCD_AC_BIAS_EN, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
+			AM33XX_PADCONF(AM335X_PIN_GPMC_CLK, PIN_OUTPUT_PULLUP, MUX_MODE7)	/* gpio2_1, LCD_DISP */
+		>;
+	};
+};
-- 
