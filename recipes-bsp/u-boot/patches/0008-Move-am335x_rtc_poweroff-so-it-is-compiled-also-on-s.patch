From f565e04a64d26f0f813e140f0e5af93b790a52ee Mon Sep 17 00:00:00 2001
From: Matteo Geromin <geromin.matteo@gmail.com>
Date: Mon, 2 Nov 2026 22:18:24 +0100
Subject: [PATCH 08/17] Move am335x_rtc_poweroff so it is compiled also on
 second stage

Move am335x_rtc_poweroff() out of the !SKIP_LOWLEVEL_INIT (SPL-only)
block so U-Boot proper can use it too.

U-Boot proper uses DM_PMIC, where the legacy tps65217_reg_write() API
is not built, so add am335x_pmic_set_off() to set the TPS65217 OFF bit
through the DM PMIC driver in U-Boot proper and via the legacy API
(after power_tps65217_init()) in SPL.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/ti/am335x/board.c | 121 ++++++++++++++++++++++++----------------
 1 file changed, 73 insertions(+), 48 deletions(-)

diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
index 6daee3dbe81..061c96a15b5 100644
--- a/board/ti/am335x/board.c
+++ b/board/ti/am335x/board.c
@@ -43,6 +43,7 @@
 #include <linux/bitops.h>
 #include <linux/compiler.h>
 #include <linux/delay.h>
+#include <power/pmic.h>
 #include <power/tps65217.h>
 #include <power/tps65910.h>
 #include <env_internal.h>
@@ -99,6 +100,78 @@ struct serial_device *default_serial_console(void)
 }
 #endif
 
+/* Set the TPS65217 OFF bit so the PMIC powers down on the next RTC alarm */
+static int am335x_pmic_set_off(void)
+{
+#if CONFIG_IS_ENABLED(DM_PMIC)
+	struct udevice *dev;
+	int ret;
+
+	ret = uclass_get_device_by_driver(UCLASS_PMIC,
+					  DM_DRIVER_GET(pmic_tps65217), &dev);
+	if (ret)
+		return ret;
+
+	return pmic_clrsetbits(dev, TPS65217_STATUS, TPS65217_PWR_OFF,
+			       TPS65217_PWR_OFF);
+#else
+	/* Make sure the PMIC is reachable (also when called from a command) */
+	if (power_tps65217_init(0))
+		return -ENODEV;
+
+	return tps65217_reg_write(TPS65217_PROT_LEVEL_NONE, TPS65217_STATUS,
+				  TPS65217_PWR_OFF, TPS65217_PWR_OFF);
+#endif
+}
+
+void am335x_rtc_poweroff(void) {
+	int reg_val;
+	struct rtc_time tm;
+
+	if (am335x_pmic_set_off())
+		puts("tps65217_reg_write failure\n");
+
+	/* Set the Power Enable PMIC*/
+	reg_val=readl(0x44e3e000 + 0x98);
+	writel(reg_val | 0x10000, (0x44e3e000 + 0x98)); // Enable PWR_ENABLE_BIT
+	/* Rather than play the roll over game, just wait an extra second */
+	do {
+		/* Wait unit the busy bit is cleared.  Max 15 uS */
+		while(readl(0x44e3e000 + 0x44) & 0x1) {
+		}
+
+		/* Read the current time, convert from binary */
+		tm.tm_sec = bcd2bin(readb(0x44e3e000 + 0x00));
+		tm.tm_min = bcd2bin(readb(0x44e3e000 + 0x04));
+		tm.tm_hour = bcd2bin(readb(0x44e3e000 + 0x08));
+		tm.tm_mday = bcd2bin(readb(0x44e3e000 + 0x0C));
+		tm.tm_mon = bcd2bin(readb(0x44e3e000 + 0x10));
+		tm.tm_year = bcd2bin(readb(0x44e3e000 + 0x14));
+
+		if (59 == tm.tm_sec) {
+			mdelay(100);
+		}
+
+	} while (59 == tm.tm_sec);
+
+	tm.tm_sec++;
+
+	/* Write the Alarm 2 Register with the shutdown time */
+	writeb(bin2bcd(tm.tm_sec), 0x44e3e000 + 0x80);
+	writeb(bin2bcd(tm.tm_min), 0x44e3e000 + 0x84);
+	writeb(bin2bcd(tm.tm_hour), 0x44e3e000 + 0x88);
+	writeb(bin2bcd(tm.tm_mday), 0x44e3e000 + 0x8C);
+	writeb(bin2bcd(tm.tm_mon), 0x44e3e000 + 0x90);
+	writeb(bin2bcd(tm.tm_year), 0x44e3e000 + 0x94);
+
+	/* Enable the Alarm 2 Interrupt */
+	reg_val=readl(0x44e3e000 + 0x48);
+	writel(reg_val | 0x10, (0x44e3e000 + 0x48)); // Enable Alarm2 interrupt once
+
+	/* Power is being pulled */
+	while(1);
+}
+
 #if !CONFIG_IS_ENABLED(SKIP_LOWLEVEL_INIT)
 static const struct ddr_data ddr2_data = {
 	.datardsratio0 = MT47H128M16RT25E_RD_DQS,
@@ -284,54 +357,6 @@ const struct dpll_params *get_dpll_ddr_params(void)
 		return &dpll_ddr2_266MHz[ind];
 }
 
