From 51492dd40ebfe82e1e05aebd7a4367b836b79d4b Mon Sep 17 00:00:00 2001
From: Matteo Geromin <geromin.matteo@gmail.com>
Date: Mon, 2 Nov 2026 22:09:00 +0100
Subject: [PATCH 03/17] Add Beaglebone LCD support

Port of the 2015 BeagleBone LCD patch to the DM video stack:

- Describe the 480x272 Casio COM57H531x panel (tilcdc panel binding)
  in a new am335x-boneblack-u-boot.dtsi; LCD DISEN (GPIO3_19) is the
  panel enable GPIO. The lcdc node is tagged bootph-all so the frame
  buffer is reserved before relocation. The pixel clock is now set up
  by the clock framework instead of conf_disp_pll().
- Add the BeagleBone LCD pinmux (16-bit data, DISEN, gpmc_a2) applied
  on bone_lt boards from U-Boot proper.
- Enable SPLASH_SCREEN/CMD_BMP and add the load_splash/splashimage/
  splashfile env; splash_screen_prepare() runs 'load_splash' to load
  the BMP (replaces the old cfb_console hook).
- On bone_lt boards, turn on the power LED (GPIO1_16) and start the
  eCAP0 backlight PWM in board_late_init().

The cfb_console colour swap and the fixed da8xx frame buffer address
are not ported: the DM video uclass allocates the frame buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/am335x-boneblack-u-boot.dtsi | 63 +++++++++++++++++++
 board/ti/am335x/board.c                   | 76 +++++++++++++++++++++++
 board/ti/am335x/mux_lcd.c                 | 29 +++++++++
 configs/am335x_evm_defconfig              |  6 ++
 include/configs/am335x_evm.h              | 11 ++++
 5 files changed, 185 insertions(+)
 create mode 100644 arch/arm/dts/am335x-boneblack-u-boot.dtsi

diff --git a/arch/arm/dts/am335x-boneblack-u-boot.dtsi b/arch/arm/dts/am335x-boneblack-u-boot.dtsi
new file mode 100644
index 00000000000..e7bbbaa5009
--- /dev/null
+++ b/arch/arm/dts/am335x-boneblack-u-boot.dtsi
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot additions for the BeagleBone Black based 3D printer board:
+ * 480x272 parallel RGB LCD panel driven by the AM335x LCD controller.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "am33xx-u-boot.dtsi"
+
+/ {
+	panel {
+		compatible = "ti,tilcdc,panel";
+		/* LCD DISEN: GPIO3_19 (mcasp0_fsr) */
+		enable-gpios = <&gpio3 19 GPIO_ACTIVE_HIGH>;
+
+		panel-info {
+			ac-bias = <255>;
+			ac-bias-intrpt = <0>;
+			dma-burst-sz = <16>;
+			bpp = <32>;
+			fdd = <0x80>;
+			sync-edge = <0>;
+			sync-ctrl = <1>;
+			raster-order = <0>;
+			fifo-th = <0>;
+		};
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			/* Casio COM57H531x */
+			timing0: 480x272 {
+				clock-frequency = <9000000>;
+				hactive = <480>;
+				vactive = <272>;
+				hfront-porch = <9>;
+				hback-porch = <44>;
+				hsync-len = <5>;
+				vfront-porch = <4>;
+				vback-porch = <13>;
+				vsync-len = <10>;
+				/* invert_line_clock / invert_frm_clock */
+				hsync-active = <0>;
+				vsync-active = <0>;
+			};
+		};
+	};
+};
+
+/* The video device must be bound before relocation to reserve its frame buffer */
+&l4_per {
+	bootph-all;
+	segment@300000 {
+		bootph-all;
+		target-module@e000 {
+			bootph-all;
+
+			lcdc: lcdc@0 {
+				bootph-all;
+			};
+		};
+	};
+};
diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
index 90e4c001bb1..6daee3dbe81 100644
--- a/board/ti/am335x/board.c
+++ b/board/ti/am335x/board.c
@@ -8,6 +8,7 @@
  */
 
 #include <config.h>
+#include <command.h>
 #include <dm.h>
 #include <env.h>
 #include <errno.h>
@@ -18,6 +19,7 @@
 #include <net.h>
 #include <spl.h>
 #include <serial.h>
+#include <splash.h>
 #include <rtc.h>
 #include <asm/arch/cpu.h>
 #include <asm/arch/hardware.h>
@@ -762,6 +764,70 @@ done:
 }
 #endif
 
+#if !defined(CONFIG_XPL_BUILD)
+static int set_gpio(int gpio, int state)
+{
+	int ret;
+
+	ret = gpio_request(gpio, "temp");
+	if (ret)
+		return ret;
+	gpio_direction_output(gpio, state);
+	gpio_set_value(gpio, state);
+	gpio_free(gpio);
+	return 0;
+}
+#endif
+
+#if IS_ENABLED(CONFIG_AM335X_LCD) && !defined(CONFIG_XPL_BUILD)
+/* LCD backlight PWM on eCAP0 */
+#define PWM_TICKS	0x1388
+#define PWM_DUTY	0x1000
+
+static int enable_pwm(void)
+{
+	struct cm_perpll *cmper = (struct cm_perpll *)CM_PER;
+	struct pwmss_regs *pwmss = (struct pwmss_regs *)PWMSS0_BASE;
+	struct pwmss_ecap_regs *ecap;
+	int ticks = PWM_TICKS;
+	int duty = PWM_DUTY;
+
+	/* Enable PWMSS0 module clock */
+	writel(0x2, &cmper->epwmss0clkctrl);
+
+	ecap = (struct pwmss_ecap_regs *)AM33XX_ECAP0_BASE;
+	/* enable clock */
+	setbits_le32(&pwmss->clkconfig, ECAP_CLK_EN);
+	/* TimeStam Counter register */
+	writel(0xdb9, &ecap->tsctr);
+	/* config period */
+	writel(ticks - 1, &ecap->cap3);
+	writel(ticks - 1, &ecap->cap1);
+	setbits_le16(&ecap->ecctl2,
+		     (ECTRL2_MDSL_ECAP | ECTRL2_SYNCOSEL_MASK | 0xd0));
+	/* config duty */
+	writel(duty, &ecap->cap2);
+	writel(duty, &ecap->cap4);
+	/* start */
+	setbits_le16(&ecap->ecctl2, ECTRL2_CTRSTP_FREERUN);
+	return 0;
+}
+
+/*
+ * Load the splash BMP to ${splashimage} by running the 'load_splash'
+ * environment script before the splash screen is drawn.
+ */
+int splash_screen_prepare(void)
+{
+	if (!env_get("load_splash")) {
+		printf("Set 'load_splash' command to load BMP file\n");
+		return -ENOENT;
+	}
+
+	return run_command("run load_splash", 0);
+}
+#endif
+
 static bool __maybe_unused prueth_is_mii = true;
 
 /*
@@ -968,6 +1034,16 @@ int board_late_init(void)
 			env_set("serial#", board_serial);
 	}
 
+#if !defined(CONFIG_XPL_BUILD)
+	if (board_is_bone_lt()) {
+		/* Enable Power-ON led */
+		set_gpio(48, 1); /* gpio1_16 */
+#if IS_ENABLED(CONFIG_AM335X_LCD)
+		enable_pwm();
+#endif
+	}
+#endif
+
 	/* Just probe the potentially supported cdce913 device */
 	uclass_get_device_by_name(UCLASS_CLK, "cdce913@65", &dev);
 
diff --git a/board/ti/am335x/mux_lcd.c b/board/ti/am335x/mux_lcd.c
index ba3c52f5e88..ac6eaa15cad 100644
--- a/board/ti/am335x/mux_lcd.c
+++ b/board/ti/am335x/mux_lcd.c
@@ -48,8 +48,37 @@ static struct module_pin_mux lcd_pin_mux[] = {
 	{-1},
 };
 
+/* BeagleBone Black 3D printer: 16-bit RGB565 LCD */
+static struct module_pin_mux bbb_lcd_pin_mux[] = {
+	{OFFSET(lcd_data0), MODE(0) },     /* lcd_data0 */
+	{OFFSET(lcd_data1), MODE(0) },     /* lcd_data1 */
+	{OFFSET(lcd_data2), MODE(0) },     /* lcd_data2 */
+	{OFFSET(lcd_data3), MODE(0) },     /* lcd_data3 */
+	{OFFSET(lcd_data4), MODE(0) },     /* lcd_data4 */
+	{OFFSET(lcd_data5), MODE(0) },     /* lcd_data5 */
+	{OFFSET(lcd_data6), MODE(0) },     /* lcd_data6 */
+	{OFFSET(lcd_data7), MODE(0) },     /* lcd_data7 */
+	{OFFSET(lcd_data8), MODE(0) },     /* lcd_data8 */
+	{OFFSET(lcd_data9), MODE(0) },     /* lcd_data9 */
+	{OFFSET(lcd_data10), MODE(0) },    /* lcd_data10 */
+	{OFFSET(lcd_data11), MODE(0) },    /* lcd_data11 */
+	{OFFSET(lcd_data12), MODE(0) },    /* lcd_data12 */
+	{OFFSET(lcd_data13), MODE(0) },    /* lcd_data13 */
+	{OFFSET(lcd_data14), MODE(0) },    /* lcd_data14 */
+	{OFFSET(lcd_data15), MODE(0) },    /* lcd_data15 */
+	{OFFSET(lcd_vsync), MODE(0) },     /* lcd_vsync */
+	{OFFSET(lcd_hsync), MODE(0) },     /* lcd_hsync */
+	{OFFSET(lcd_pclk), MODE(0) },       /* lcd_pclk */
+	{OFFSET(lcd_ac_bias_en), MODE(0) }, /* lcd_en */
+	{OFFSET(mcasp0_fsr), (MODE(7) | PULLUP_EN | RXACTIVE)}, /*LCD DISEN*/
+	{OFFSET(gpmc_a2), MODE(7) | PULLDOWN_EN | RXACTIVE},
+	{-1},
+};
+
 void enable_board_lcd_pin_mux(void)
 {
 	if (board_is_gp_evm())
 		configure_module_pin_mux(lcd_pin_mux);
+	else if (board_is_bone_lt())
+		configure_module_pin_mux(bbb_lcd_pin_mux);
 }
