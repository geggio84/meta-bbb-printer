From 2c727ec71e4670cda3a8717beda7cbe77085a667 Mon Sep 17 00:00:00 2001
From: Matteo Geromin <geromin.matteo@gmail.com>
Date: Wed, 4 Nov 2026 22:03:12 +0100
Subject: [PATCH 18/18] Load am335x-bbb-printer.dtb by default

The bbb-printer board is a BeagleBone Black (EEPROM board name
A335BNLT), and the bbb-printer pinmux is already applied for it in
mux.c. Make findfdt select the bbb-printer kernel device tree for it,
and fall back to the same device tree when the board can't be
identified, instead of leaving fdtfile undefined.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/configs/am335x_evm.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/include/configs/am335x_evm.h b/include/configs/am335x_evm.h
index 97f3c7f..0828c3b 100644
--- a/include/configs/am335x_evm.h
+++ b/include/configs/am335x_evm.h
@@ -148,7 +148,7 @@
 		"if test $board_name = A335BONE; then " \
 			"setenv fdtfile am335x-bone.dtb; fi; " \
 		"if test $board_name = A335BNLT; then " \
-			"setenv fdtfile am335x-boneblack.dtb; fi; " \
+			"setenv fdtfile am335x-bbb-printer.dtb; fi; " \
 		"if test $board_name = A335PBGL; then " \
 			"setenv fdtfile am335x-pocketbeagle.dtb; fi; " \
 		"if test $board_name = BBBW; then " \
@@ -176,7 +176,9 @@
 		"if test $board_name = A335_ICE && test $ice_mii = mii; then " \
 			"setenv fdtfile am335x-icev2-prueth.dtb; fi; " \
 		"if test $fdtfile = undefined; then " \
-			"echo WARNING: Could not determine device tree to use; fi; \0" \
+			"echo WARNING: Could not determine device tree to use, " \
+				"falling back to am335x-bbb-printer.dtb; " \
+			"setenv fdtfile am335x-bbb-printer.dtb; fi; \0" \
 	"init_console=" \
 		"if test $board_name = A335_ICE; then "\
 			"setenv console ttyO3,115200n8;" \
-- 
