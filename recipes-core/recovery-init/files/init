#!/bin/sh
#
# bbb-printer recovery ramdisk init (PID 1)
#
# Booted by U-Boot "ramboot" from the uSD card when the eMMC system
# failed to boot 3 times, when booting from uSD (S2) or when the front
# button is held at power on.
#
# - exports the uSD "UPDATE" partition as a USB drive on the OTG port
# - brings up USB networking (board 192.168.7.2, PC gets 192.168.7.1)
# - starts dropbear (ssh root@192.168.7.2, no password)
# - gives a root shell on the serial console

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
exec </dev/console >/dev/console 2>&1
mkdir -p /dev/pts /run /tmp /var/run /media
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config

hostname bbb-recovery
ip link set lo up

echo
echo "=============================================="
echo " bbb-printer RECOVERY mode"
echo " U-Boot boot counter: $(bootcount get 2>/dev/null)"
echo "=============================================="

# Wait for the MMC devices (eMMC = mmcblk1, uSD = mmcblk0)
i=0
while [ ! -b /dev/mmcblk0 ] || [ ! -b /dev/mmcblk1 ]; do
	i=$((i + 1))
	[ $i -gt 50 ] && break
	sleep 0.1
done

usb-gadget start

if ip link show usb0 >/dev/null 2>&1; then
	ip addr add 192.168.7.2/30 dev usb0
	ip link set usb0 up
	udhcpd /etc/udhcpd-usb0.conf
fi

mkdir -p /etc/dropbear
dropbear -R -B

cp /etc/recovery-motd /etc/motd
cat /etc/motd

# Root shell on the console, restarted when it exits. PID 1 must never exit.
while true; do
	setsid sh -c 'exec sh -l </dev/console >/dev/console 2>&1'
	sleep 1
done
