# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "5"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

# Layers configured by oe-core-setup script
BBLAYERS += " \
	##COREBASE##/meta-tisdk/meta-ti-foundational \
	##COREBASE##/meta-tisdk/meta-ti-ml \
	##COREBASE##/meta-arago/meta-arago-distro \
	##COREBASE##/meta-arago/meta-arago-extras \
	##COREBASE##/meta-arago/meta-arago-test \
	##COREBASE##/meta-qt6 \
	##COREBASE##/meta-virtualization \
	##COREBASE##/meta-openembedded/meta-networking \
	##COREBASE##/meta-openembedded/meta-python \
	##COREBASE##/meta-openembedded/meta-oe \
	##COREBASE##/meta-openembedded/meta-gnome \
	##COREBASE##/meta-openembedded/meta-filesystems \
	##COREBASE##/meta-openembedded/meta-multimedia \
	##COREBASE##/meta-lts-mixins \
	##COREBASE##/meta-ti/meta-ti-extras \
	##COREBASE##/meta-ti/meta-beagle \
	##COREBASE##/meta-ti/meta-ti-bsp \
	##COREBASE##/meta-arm/meta-arm \
	##COREBASE##/meta-arm/meta-arm-toolchain \
	##COREBASE##/meta-clang \
	##COREBASE##/oe-core/meta \
	##COREBASE##/meta-bbb-printer \
"
